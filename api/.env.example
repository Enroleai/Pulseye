# Generate a long, unique value and store it in the deployment secret manager.
JWT_PRIVATE_KEY=replace-with-a-long-random-secret

# Store the database connection string only in the deployment secret manager.
MONGODB_URI=mongodb+srv://username:password@cluster.example.com/PULSEYE_DATABASE?retryWrites=true&w=majority

# Comma-separated browser origins that may call the API.
CORS_ORIGIN=https://app.pulseye.co.uk
PORT=3000

# Native AWS S3 (default): use the SDK credential chain / EC2 instance role.
# No static access keys or endpoint are required. Never commit credentials.
AWS_REGION=ap-south-1
S3_BUCKET=pulseyeprod
# AWS_BUCKET is an alternative to S3_BUCKET. If both are set they must match.
# AWS_BUCKET=pulseyeprod
# Leave AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_SESSION_TOKEN unset
# on EC2 to use the instance role. Partial explicit AWS key pairs are rejected.

# Optional legacy DigitalOcean Spaces mode: uncomment ONLY when needed.
# An explicit endpoint AND a complete SPACES_* key pair select legacy mode.
# An incomplete legacy configuration is rejected (no silent AWS fallback).
# SPACES_ACCESS_KEY_ID=replace-with-access-key-id
# SPACES_SECRET_ACCESS_KEY=replace-with-secret-access-key
# SPACES_ENDPOINT=fra1.digitaloceanspaces.com
# SPACES_REGION=us-east-2
# SPACES_BUCKET=employee-screenshots
# Native AWS uses private JPEG uploads with AES256 encryption and no ACL.
# Legacy Spaces uploads omit ServerSideEncryption for compatibility.
